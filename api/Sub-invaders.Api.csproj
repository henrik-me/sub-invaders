<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SubInvaders.Api</RootNamespace>
    <!-- Issue #52: bake the deploy commit SHA into AssemblyInformationalVersionAttribute
         at build time. swa-deploy.yml exposes BUILD_COMMIT=${{ github.sha }} on the
         build job so Oryx forwards it to dotnet build. Local builds without
         BUILD_COMMIT inherit the MSBuild default ("1.0.0"), which BuildInfoProvider
         maps to the legacy "unknown" sentinel. -->
    <InformationalVersion Condition="'$(BUILD_COMMIT)' != ''">$(BUILD_COMMIT)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Sub-invaders.Api.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #52: expose internal BuildInfoProvider.ParseCommitFromInformationalVersion
         to the unit-test project so the parser can be tested as a pure function
         independently of the loaded assembly's bake-time InformationalVersion. -->
    <InternalsVisibleTo Include="Sub-invaders.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="local.settings.json" Condition="Exists('local.settings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
