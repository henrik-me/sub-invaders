{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^11.0.0",
    "http-server": "^14.1.1",
    "monocart-coverage-reports": "^2.12.11",
    "monocart-reporter": "^2.11.2"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:coverage": "playwright test --config=playwright.coverage.config.mjs",
    "test:e2e:report": "playwright show-report",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "test:unit:coverage": "c8 --reporter=text --reporter=text-summary --reporter=json-summary --reporter=lcov --include \"src/**/*.mjs\" --exclude \"src/**/*.test.mjs\" --exclude \"src/game/test-hooks.mjs\" --exclude \"src/game/api.mjs\" --report-dir=coverage-report-unit --check-coverage --lines=90 --statements=90 --functions=90 --branches=85 node --test \"src/**/*.test.mjs\"",
    "serve": "http-server src -p 4173 --silent -c-1"
  }
}
